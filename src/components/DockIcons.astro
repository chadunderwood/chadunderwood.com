---
interface Props {
  id: string;
}
const { id } = Astro.props;
---
{id === 'home' && (
  <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#5B8DEF"/><path d="M8 15.2L16 9l8 6.2V24a1 1 0 0 1-1 1h-4.5v-5.5h-5V25H9a1 1 0 0 1-1-1v-8.8z" fill="#fff"/></svg>
)}
{id === 'writing' && (
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="#34C759"/>
    {/* Document with folded corner */}
    <path d="M9.5 7.5h9.2L22.5 11.3V24.2A1.3 1.3 0 0 1 21.2 25.5H10.8A1.3 1.3 0 0 1 9.5 24.2V8.8A1.3 1.3 0 0 1 10.8 7.5H9.5z" fill="#fff"/>
    <path d="M18.7 7.5v3.6h3.8L18.7 7.5z" fill="#D8F5E0"/>
    <path d="M12.2 14.2h7.6M12.2 17.4h7.6M12.2 20.6h5" fill="none" stroke="#34C759" stroke-width="1.5" stroke-linecap="round"/>
  </svg>
)}
{id === 'work' && (
  <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#FF9F0A"/><path d="M11 12h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H11a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2zm1.5-3h7a1 1 0 0 1 1 1v2h-9v-2a1 1 0 0 1 1-1z" fill="#fff"/></svg>
)}
{id === 'photos' && (
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="#BF5AF2"/>
    {/* Filmstrip */}
    <rect x="8" y="8.5" width="16" height="15" rx="1.5" fill="#fff"/>
    <rect x="8" y="8.5" width="3.2" height="15" fill="#EBD4FF"/>
    <rect x="20.8" y="8.5" width="3.2" height="15" fill="#EBD4FF"/>
    <rect x="8.7" y="10.2" width="1.8" height="1.8" rx="0.3" fill="#BF5AF2"/>
    <rect x="8.7" y="13.6" width="1.8" height="1.8" rx="0.3" fill="#BF5AF2"/>
    <rect x="8.7" y="17" width="1.8" height="1.8" rx="0.3" fill="#BF5AF2"/>
    <rect x="8.7" y="20.4" width="1.8" height="1.8" rx="0.3" fill="#BF5AF2"/>
    <rect x="21.5" y="10.2" width="1.8" height="1.8" rx="0.3" fill="#BF5AF2"/>
    <rect x="21.5" y="13.6" width="1.8" height="1.8" rx="0.3" fill="#BF5AF2"/>
    <rect x="21.5" y="17" width="1.8" height="1.8" rx="0.3" fill="#BF5AF2"/>
    <rect x="21.5" y="20.4" width="1.8" height="1.8" rx="0.3" fill="#BF5AF2"/>
    <rect x="12.2" y="11" width="7.6" height="4.2" rx="0.6" fill="#BF5AF2" opacity="0.35"/>
    <rect x="12.2" y="16.8" width="7.6" height="4.2" rx="0.6" fill="#BF5AF2" opacity="0.55"/>
  </svg>
)}
{id === 'now' && (
  <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#FF453A"/><circle cx="16" cy="16" r="8" fill="none" stroke="#fff" stroke-width="2"/><path d="M16 11v5.2l3.2 2" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
)}
{id === 'signal' && (
  <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#64D2FF"/><path d="M9 10h14a1 1 0 0 1 1 1v8.5a1 1 0 0 1-1 1h-6.2L12 24v-3.5H9a1 1 0 0 1-1-1V11a1 1 0 0 1 1-1z" fill="#fff"/></svg>
)}
{id === 'elsewhere' && (
  <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#AC8E68"/><circle cx="11" cy="12" r="2.2" fill="#fff"/><circle cx="21" cy="12" r="2.2" fill="#fff"/><circle cx="16" cy="20" r="2.2" fill="#fff"/><path d="M12.8 13.2l2.4 5.2M19.2 13.2l-2.4 5.2" stroke="#fff" stroke-width="1.4"/></svg>
)}
{id === 'colophon' && (
  <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#8E8E93"/><text x="16" y="21" text-anchor="middle" font-size="13" font-family="system-ui,sans-serif" font-weight="700" fill="#fff">⌘</text></svg>
)}
{id === 'email' && (
  <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#0A84FF"/><path d="M8.5 11h15a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1zm.8 1.4l6.7 5.1 6.7-5.1" fill="none" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/></svg>
)}
