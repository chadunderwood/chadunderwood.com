---
import Base from '../../layouts/Base.astro';
import { getPublishedWriting, formatDate, editionLabel } from '../../lib/writing';

const posts = await getPublishedWriting();
const latest = posts[0];
---

<Base
  title="Writing"
  description="Essays and notes by Chad Underwood."
  latestWritingId={latest?.id ?? null}
  latestWritingDate={latest ? latest.data.date.toISOString() : null}
>
  <div class="page">
    <h1 class="page-title">Writing</h1>
    <p class="page-dek">Essays and notes. RSS at <a href="/rss.xml">/rss.xml</a>.</p>

    {posts.length === 0 ? (
      <p class="empty-state" id="writing-empty">Writing soon.</p>
    ) : (
      <ul class="writing-list" id="writing-list" data-api-url="/api/writing">
        {posts.map((post) => {
          const ed = editionLabel(post.data);
          return (
            <li>
              <a class="writing-link" href={`/writing/${post.id}/`}>
                <span class="writing-title">
                  {post.data.title}
                  {post.data.example && <span class="badge-example">Example</span>}
                </span>
                {post.data.summary && <span class="writing-dek">{post.data.summary}</span>}
                <span class="meta">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  {ed && <> · {ed}</>}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</Base>


<script>
  function formatDateUTC(iso) {
    try {
      return new Date(iso).toLocaleDateString('en-US', {
        year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
      });
    } catch { return iso; }
  }
  function escapeHtml(s) {
    return String(s || '')
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  async function overlayApiWriting() {
    const list = document.getElementById('writing-list');
    const empty = document.getElementById('writing-empty');
    const url = (list && list.getAttribute('data-api-url')) || '/api/writing';
    let posts = [];
    try {
      const res = await fetch(url, { cache: 'no-store' });
      if (!res.ok) return;
      const data = await res.json();
      if (!Array.isArray(data) || !data.length) return;
      posts = data;
    } catch { return; }

    // Merge: API posts win by slug; keep static-only posts not in API
    const bySlug = new Map();
    if (list) {
      list.querySelectorAll('a.writing-link').forEach((a) => {
        const href = a.getAttribute('href') || '';
        const m = href.match(/\/writing\/([^/]+)\//);
        if (m) bySlug.set(m[1], a.closest('li'));
      });
    }
    const apiSlugs = new Set(posts.map((p) => p.slug));
    // Rebuild list from API (canonical live source) when API has data
    let ul = list;
    const root = document.querySelector('.page');
    if (!ul && root) {
      if (empty) empty.remove();
      ul = document.createElement('ul');
      ul.className = 'writing-list';
      ul.id = 'writing-list';
      ul.setAttribute('data-api-url', '/api/writing');
      root.appendChild(ul);
    }
    if (!ul) return;
    if (empty) empty.remove();
    const parts = [];
    for (const post of posts) {
      const slug = post.slug;
      const title = escapeHtml(String(post.title || slug).replace(/^#+\s*/, ''));
      const dek = post.summary ? '<span class="writing-dek">' + escapeHtml(post.summary) + '</span>' : '';
      const date = escapeHtml(formatDateUTC(post.date || ''));
      parts.push(
        '<li><a class="writing-link" href="/writing/' + encodeURIComponent(slug) + '/">' +
        '<span class="writing-title">' + title + '</span>' + dek +
        '<span class="meta"><time datetime="' + escapeHtml(post.date || '') + '">' + date + '</time></span>' +
        '</a></li>'
      );
    }
    // Keep static-only essays not yet in KV
    if (list) {
      list.querySelectorAll('li').forEach((li) => {
        const a = li.querySelector('a.writing-link');
        const href = (a && a.getAttribute('href')) || '';
        const m = href.match(/\/writing\/([^/]+)\//);
        if (m && !apiSlugs.has(m[1])) {
          parts.push(li.outerHTML);
        }
      });
    }
    ul.innerHTML = parts.join('');
  }
  overlayApiWriting();
</script>
