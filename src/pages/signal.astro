---
import Base from '../layouts/Base.astro';
import posts from '../content/signal/posts.json';
import { getPublishedWriting, formatDate } from '../lib/writing';
import { marked } from 'marked';

const writing = await getPublishedWriting();
const latest = writing[0];
const entries = [...posts].sort((a, b) => (a.date < b.date ? 1 : -1));

const PAGE_SIZE = 10;
const requestedPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1);
const totalPages = Math.max(1, Math.ceil(entries.length / PAGE_SIZE) || 1);
const page = Math.min(requestedPage, totalPages);
const pageSlice = entries.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

async function renderBody(body: string): Promise<string> {
  return await marked.parse(String(body || ''), { breaks: true, gfm: true });
}

const ssrEntries = await Promise.all(
  pageSlice.map(async (e) => ({
    id: e.id,
    date: e.date,
    dateLabel: formatDate(new Date(e.date)),
    html: await renderBody(e.body),
  })),
);

function pageHref(n: number): string {
  if (n <= 1) return '/signal/';
  return `/signal/?page=${n}`;
}
---

<Base
  title="Signal"
  description="Short posts from Chad — a quiet microblog."
  latestWritingId={latest?.id ?? null}
  latestWritingDate={latest ? latest.data.date.toISOString() : null}
>
  <div class="page">
    <h1 class="page-title">Signal</h1>
    <p class="page-dek">
      Short posts. Chronological. No likes, no threads — just notes from Chad.
    </p>

    <div
      id="signal-root"
      data-posts-url="/api/signal"
      data-page-size={String(PAGE_SIZE)}
      data-page={String(page)}
    >
      {ssrEntries.length === 0 ? (
        <p class="empty-state" id="signal-empty">No signals yet.</p>
      ) : (
        <>
          <ul class="signal-list" id="signal-list">
            {ssrEntries.map((e) => (
              <li data-id={e.id}>
                <div class="signal-body" set:html={e.html} />
                <p class="meta signal-meta">
                  <time datetime={e.date}>{e.dateLabel}</time>
                  <button type="button" class="signal-id" data-copy-id={e.id} title="Copy YYYYMMDDHHMMSS id for Drafts delete/import">
                    {e.id}
                  </button>
                </p>
              </li>
            ))}
          </ul>
          {totalPages > 1 && (
            <nav class="signal-pager" id="signal-pager" aria-label="Signal pages">
              {page > 1 ? (
                <a class="signal-pager-link" href={pageHref(page - 1)} rel="prev">Newer</a>
              ) : (
                <span class="signal-pager-link is-disabled" aria-disabled="true">Newer</span>
              )}
              <span class="signal-pager-status">
                Page {page} of {totalPages}
              </span>
              {page < totalPages ? (
                <a class="signal-pager-link" href={pageHref(page + 1)} rel="next">Older</a>
              ) : (
                <span class="signal-pager-link is-disabled" aria-disabled="true">Older</span>
              )}
            </nav>
          )}
        </>
      )}
    </div>
  </div>
</Base>

<style is:global>
  .signal-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .signal-list li + li {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  /* Padding ABOVE the dotted line; full width (no side inset). Global so client-rendered lis keep styles. */
  .signal-list li + li::before {
    content: '';
    display: block;
    box-sizing: border-box;
    width: 100%;
    padding-top: 1.35rem;
    border-bottom: 1px dotted var(--hairline);
    margin: 0 0 1.35rem;
  }
  .signal-body {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    line-height: 1.55;
    max-width: min(var(--measure), 100%);
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .signal-body p {
    margin: 0 0 0.6em;
  }
  .signal-body p:last-child {
    margin-bottom: 0;
  }
  .signal-body h1,
  .signal-body h2,
  .signal-body h3 {
    font-size: 1.1rem;
    margin: 0.8em 0 0.35em;
    line-height: 1.3;
  }
  .signal-body h1:first-child,
  .signal-body h2:first-child,
  .signal-body h3:first-child {
    margin-top: 0;
  }
  .signal-pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin: 1.75rem 0 0;
    font-size: 0.92rem;
  }
  .signal-pager-status {
    color: var(--text-muted);
  }
  .signal-pager-link {
    color: var(--text-muted);
    text-decoration: none;
  }
  .signal-pager-link:hover,
  .signal-pager-link:focus-visible {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .signal-pager-link.is-disabled {
    opacity: 0.4;
    pointer-events: none;
  }
  .signal-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 0.85rem;
    margin: 0;
  }
  .signal-id {
    appearance: none;
    background: transparent;
    border: 0;
    margin: 0;
    padding: 0;
    font: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--text-muted) 78%, transparent);
    cursor: pointer;
    text-decoration: none;
  }
  .signal-id:hover,
  .signal-id:focus-visible {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .signal-id[data-copied='1'] {
    color: var(--accent-b);
  }
</style>



<script>
  import { marked } from 'marked';

  const PAGE_SIZE_DEFAULT = 10;

  function formatDateUTC(iso: string): string {
    try {
      return new Date(iso).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        timeZone: 'UTC',
      });
    } catch {
      return iso;
    }
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  async function renderBody(body: string): Promise<string> {
    try {
      return await marked.parse(String(body || ''), { breaks: true, gfm: true });
    } catch {
      return '<p>' + escapeHtml(String(body || '')).replace(/\n/g, '<br>') + '</p>';
    }
  }

  type Post = { id: string; date: string; body: string };

  function pageFromUrl(): number {
    const n = parseInt(new URL(location.href).searchParams.get('page') || '1', 10);
    return Number.isFinite(n) && n > 0 ? n : 1;
  }

  function pageHref(n: number): string {
    if (n <= 1) return '/signal/';
    return '/signal/?page=' + n;
  }

  function renderPager(root: HTMLElement, page: number, totalPages: number) {
    let pager = document.getElementById('signal-pager');
    if (totalPages <= 1) {
      if (pager) pager.remove();
      return;
    }
    if (!pager) {
      pager = document.createElement('nav');
      pager.className = 'signal-pager';
      pager.id = 'signal-pager';
      pager.setAttribute('aria-label', 'Signal pages');
      root.appendChild(pager);
    }
    const newer =
      page > 1
        ? '<a class="signal-pager-link" href="' + pageHref(page - 1) + '" rel="prev">Newer</a>'
        : '<span class="signal-pager-link is-disabled" aria-disabled="true">Newer</span>';
    const older =
      page < totalPages
        ? '<a class="signal-pager-link" href="' + pageHref(page + 1) + '" rel="next">Older</a>'
        : '<span class="signal-pager-link is-disabled" aria-disabled="true">Older</span>';
    pager.innerHTML =
      newer +
      '<span class="signal-pager-status">Page ' +
      page +
      ' of ' +
      totalPages +
      '</span>' +
      older;
  }

  async function loadLivePosts() {
    const root = document.getElementById('signal-root');
    if (!root) return;
    const url = root.getAttribute('data-posts-url') || '/api/signal';
    const pageSize = Math.max(
      1,
      parseInt(root.getAttribute('data-page-size') || String(PAGE_SIZE_DEFAULT), 10) || PAGE_SIZE_DEFAULT,
    );
    let posts: Post[] = [];
    try {
      const res = await fetch(url, { cache: 'no-store' });
      if (!res.ok) return;
      const data = await res.json();
      if (!Array.isArray(data)) return;
      posts = data as Post[];
    } catch {
      return; // keep SSR fallback
    }

    posts = [...posts].sort((a, b) => (a.date < b.date ? 1 : -1));

    let list = document.getElementById('signal-list');
    const empty = document.getElementById('signal-empty');

    if (posts.length === 0) {
      if (list) list.remove();
      document.getElementById('signal-pager')?.remove();
      if (!empty) {
        const p = document.createElement('p');
        p.className = 'empty-state';
        p.id = 'signal-empty';
        p.textContent = 'No signals yet.';
        root.appendChild(p);
      }
      return;
    }

    if (empty) empty.remove();
    if (!list) {
      list = document.createElement('ul');
      list.className = 'signal-list';
      list.id = 'signal-list';
      root.appendChild(list);
    }

    const totalPages = Math.max(1, Math.ceil(posts.length / pageSize));
    const page = Math.min(pageFromUrl(), totalPages);
    const slice = posts.slice((page - 1) * pageSize, page * pageSize);

    const htmlParts: string[] = [];
    for (const e of slice) {
      const bodyHtml = await renderBody(e.body || '');
      const id = escapeHtml(e.id || '');
      htmlParts.push(
        '<li data-id="' +
          id +
          '"><div class="signal-body">' +
          bodyHtml +
          '</div><p class="meta signal-meta"><time datetime="' +
          escapeHtml(e.date || '') +
          '">' +
          escapeHtml(formatDateUTC(e.date || '')) +
          '</time><button type="button" class="signal-id" data-copy-id="' +
          id +
          '" title="Copy YYYYMMDDHHMMSS id for Drafts delete/import">' +
          id +
          '</button></p></li>',
      );
    }
    list.innerHTML = htmlParts.join('');
    renderPager(root, page, totalPages);
    wireCopyIds(list);
  }

  function wireCopyIds(root: ParentNode = document) {
    root.querySelectorAll('button.signal-id[data-copy-id]').forEach((btn) => {
      if ((btn as HTMLElement).dataset.wired === '1') return;
      (btn as HTMLElement).dataset.wired = '1';
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).getAttribute('data-copy-id') || '';
        if (!id) return;
        try {
          await navigator.clipboard.writeText(id);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = id;
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch {}
          ta.remove();
        }
        (btn as HTMLElement).dataset.copied = '1';
        window.setTimeout(() => {
          (btn as HTMLElement).dataset.copied = '0';
        }, 1200);
      });
    });
  }

  loadLivePosts()
    .then(() => wireCopyIds())
    .catch(() => wireCopyIds());
  wireCopyIds();
</script>
