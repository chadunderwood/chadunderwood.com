---
import Base from '../layouts/Base.astro';
import Bio from '../components/Bio.astro';
import { getPublishedWriting } from '../lib/writing';

const posts = await getPublishedWriting();
const latest = posts[0];
---

<Base
  title="Home"
  description="Chad Underwood — builder, writer, small corner of the internet."
  latestWritingId={latest?.id ?? null}
  latestWritingDate={latest ? latest.data.date.toISOString() : null}
>
  <Bio />
</Base>
