---
import Base from '../layouts/Base.astro';
import { getPublishedWriting } from '../lib/writing';

const posts = await getPublishedWriting();
const latest = posts[0];
---

<Base
  title="Secret"
  description="A quiet page."
  noindex={true}
  latestWritingId={latest?.id ?? null}
  latestWritingDate={latest ? latest.data.date.toISOString() : null}
>
  {/* Soft-gate: redirect home unless unlocked. Letter body is NOT in this HTML. */}
  <script is:inline>
    (function () {
      try {
        if (localStorage.getItem('cu:secret-unlocked') !== '1') {
          location.replace('/');
          return;
        }
        document.documentElement.dataset.secret = 'open';
      } catch (e) {
        location.replace('/');
      }
    })();
  </script>
  <style is:global>
    html:not([data-secret='open']) [data-secret-root] {
      visibility: hidden;
    }
  </style>
  {/* Empty shell only — content injected client-side after unlock via dynamic import */}
  <div class="page prose" data-secret-root aria-busy="true"></div>
  <script>
    import { mountSecret } from '../scripts/secret';
    mountSecret();
  </script>
</Base>
